1279 [code="function _updateBookRemoveOrder(Book storage self, Order storage order) private {\n        if (order.side == Side.BUY) {\n            self.metadata().numBids--;\n            self.metadata().quoteTokenOpenInterest -= self.getQuoteTokenAmount(order.price, order.amount);\n        } else {\n            self.metadata().numAsks--;\n            self.metadata().baseTokenOpenInterest -= order.amount;\n        }\n        delete self.orders[order.id];\n    }", label="188_ function _updateBookRemoveOrder(Book storage self, Order storage order) private {\n        if (order.side == Side.BUY) {\n            self.metadata().numBids--;\n            self.metadata().quoteTokenOpenInterest -= self.getQuoteTokenAmount(order.price, order.amount);\n        } else {\n            self.metadata().numAsks--;\n            self.metadata().baseTokenOpenInterest -= order.amount;\n        }\n        delete self.orders[order.id];\n    }\n1279-function_definition-189-198", method="_updateBookRemoveOrder(Book storage self,Order storage order)", node_type=function_definition, type_label=function_definition];
