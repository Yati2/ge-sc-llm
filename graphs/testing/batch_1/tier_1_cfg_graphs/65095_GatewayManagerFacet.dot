642 [code="function fundWithToken(SubnetID calldata subnetId, FvmAddress calldata to, uint256 amount) external nonReentrant {\n        if (amount == 0) {\n            revert InvalidXnetMessage(InvalidXnetMessageReason.Value);\n        }\n        (bool registered, Subnet storage subnet) = LibGateway.getSubnet(subnetId);\n        if (!registered) {\n            revert NotRegisteredSubnet();\n        }\n        Asset memory supplySource = SubnetActorGetterFacet(subnetId.getActor()).supplySource();\n        supplySource.expect(AssetKind.ERC20);\n        uint256 transferAmount = supplySource.lock({value: amount});\n        IpcEnvelope memory crossMsg = CrossMsgHelper.createFundMsg({\n            subnet: subnetId,\n            signer: msg.sender,\n            to: to,\n            value: transferAmount\n        });\n        LibGateway.commitTopDownMsg(subnet, crossMsg);\n    }", label="106_ function fundWithToken(SubnetID calldata subnetId, FvmAddress calldata to, uint256 amount) external nonReentrant {\n        if (amount == 0) {\n            revert InvalidXnetMessage(InvalidXnetMessageReason.Value);\n        }\n        (bool registered, Subnet storage subnet) = LibGateway.getSubnet(subnetId);\n        if (!registered) {\n            revert NotRegisteredSubnet();\n        }\n        Asset memory supplySource = SubnetActorGetterFacet(subnetId.getActor()).supplySource();\n        supplySource.expect(AssetKind.ERC20);\n        uint256 transferAmount = supplySource.lock({value: amount});\n        IpcEnvelope memory crossMsg = CrossMsgHelper.createFundMsg({\n            subnet: subnetId,\n            signer: msg.sender,\n            to: to,\n            value: transferAmount\n        });\n        LibGateway.commitTopDownMsg(subnet, crossMsg);\n    }\n642-function_definition-107-125", method="fundWithToken(SubnetID calldata subnetId,FvmAddress calldata to,uint256 amount)", node_type=function_definition, type_label=function_definition];
