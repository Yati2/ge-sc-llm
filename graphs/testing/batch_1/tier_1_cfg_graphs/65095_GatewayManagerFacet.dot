528 [code="function fund(SubnetID calldata subnetId, FvmAddress calldata to) external payable {\n        if (msg.value == 0) {\n            revert InvalidXnetMessage(InvalidXnetMessageReason.Value);\n        }\n        (bool registered, Subnet storage subnet) = LibGateway.getSubnet(subnetId);\n        if (!registered) {\n            revert NotRegisteredSubnet();\n        }\n        Asset memory supplySource = SubnetActorGetterFacet(subnetId.getActor()).supplySource();\n        supplySource.expect(AssetKind.Native);\n        IpcEnvelope memory crossMsg = CrossMsgHelper.createFundMsg({\n            subnet: subnetId,\n            signer: msg.sender,\n            to: to,\n            value: msg.value\n        });\n        LibGateway.commitTopDownMsg(subnet, crossMsg);\n    }", label="88_ function fund(SubnetID calldata subnetId, FvmAddress calldata to) external payable {\n        if (msg.value == 0) {\n            revert InvalidXnetMessage(InvalidXnetMessageReason.Value);\n        }\n        (bool registered, Subnet storage subnet) = LibGateway.getSubnet(subnetId);\n        if (!registered) {\n            revert NotRegisteredSubnet();\n        }\n        Asset memory supplySource = SubnetActorGetterFacet(subnetId.getActor()).supplySource();\n        supplySource.expect(AssetKind.Native);\n        IpcEnvelope memory crossMsg = CrossMsgHelper.createFundMsg({\n            subnet: subnetId,\n            signer: msg.sender,\n            to: to,\n            value: msg.value\n        });\n        LibGateway.commitTopDownMsg(subnet, crossMsg);\n    }\n528-function_definition-89-106", method="fund(SubnetID calldata subnetId,FvmAddress calldata to)", node_type=function_definition, type_label=function_definition];
