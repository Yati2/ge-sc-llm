2393 [code="function sortTokens(address tokenA, address tokenB) internal pure returns (address token0, address token1) {\n        if (tokenA == tokenB) revert(\"UniswapV2Library: IDENTICAL_ADDRESSES\");\n        (token0, token1) = tokenA < tokenB ? (tokenA, tokenB) : (tokenB, tokenA);\n        if (token0 == address(0)) revert(\"UniswapV2Library: ZERO_ADDRESS\");\n    }", label="405_ function sortTokens(address tokenA, address tokenB) internal pure returns (address token0, address token1) {\n        if (tokenA == tokenB) revert(\"UniswapV2Library: IDENTICAL_ADDRESSES\");\n        (token0, token1) = tokenA < tokenB ? (tokenA, tokenB) : (tokenB, tokenA);\n        if (token0 == address(0)) revert(\"UniswapV2Library: ZERO_ADDRESS\");\n    }\n2393-function_definition-406-410", method="sortTokens(address tokenA,address tokenB)", node_type=function_definition, type_label=function_definition];
