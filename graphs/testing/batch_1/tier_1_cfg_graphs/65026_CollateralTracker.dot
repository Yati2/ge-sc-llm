2153 [code="function redeem(\n        uint256 shares,\n        address receiver,\n        address owner\n    ) external returns (uint256 assets) {\n        _accrueInterest(owner, IS_NOT_DEPOSIT);\n        if (shares > maxRedeem(owner)) revert Errors.ExceedsMaximumRedemption();\n        if (msg.sender != owner) {\n            uint256 allowed = allowance[owner][msg.sender];\n            if (allowed != type(uint256).max) allowance[owner][msg.sender] = allowed - shares;  \n        }\n        assets = previewRedeem(shares);\n        if (assets == 0) revert Errors.BelowMinimumRedemption();\n        _burn(owner, shares);\n        s_depositedAssets -= uint128(assets);\n        address _poolManager = address(poolManager());\n        if (_poolManager == address(0)) {\n            SafeTransferLib.safeTransferFrom(\n                underlyingToken(),\n                address(panopticPool()),\n                receiver,\n                assets\n            );\n        } else {\n            unchecked {\n                _settleCurrencyDelta(receiver, -int256(assets));\n            }\n        }\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n    }", label="373_ function redeem(\n        uint256 shares,\n        address receiver,\n        address owner\n    ) external returns (uint256 assets) {\n        _accrueInterest(owner, IS_NOT_DEPOSIT);\n        if (shares > maxRedeem(owner)) revert Errors.ExceedsMaximumRedemption();\n        if (msg.sender != owner) {\n            uint256 allowed = allowance[owner][msg.sender];\n            if (allowed != type(uint256).max) allowance[owner][msg.sender] = allowed - shares;  \n        }\n        assets = previewRedeem(shares);\n        if (assets == 0) revert Errors.BelowMinimumRedemption();\n        _burn(owner, shares);\n        s_depositedAssets -= uint128(assets);\n        address _poolManager = address(poolManager());\n        if (_poolManager == address(0)) {\n            SafeTransferLib.safeTransferFrom(\n                underlyingToken(),\n                address(panopticPool()),\n                receiver,\n                assets\n            );\n        } else {\n            unchecked {\n                _settleCurrencyDelta(receiver, -int256(assets));\n            }\n        }\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n    }\n2153-function_definition-374-403", method="redeem(uint256 shares,address receiver,address owner)", node_type=function_definition, type_label=function_definition];
