1713 [code="function withdraw(\n        uint256 assets,\n        address receiver,\n        address owner\n    ) external returns (uint256 shares) {\n        _accrueInterest(owner, IS_NOT_DEPOSIT);\n        if (assets > maxWithdraw(owner)) revert Errors.ExceedsMaximumRedemption();\n        if (assets == 0) revert Errors.BelowMinimumRedemption();\n        shares = previewWithdraw(assets);\n        if (msg.sender != owner) {\n            uint256 allowed = allowance[owner][msg.sender];\n            if (allowed != type(uint256).max) allowance[owner][msg.sender] = allowed - shares;  \n        }\n        _burn(owner, shares);\n        s_depositedAssets -= uint128(assets);\n        address _poolManager = address(poolManager());\n        if (_poolManager == address(0)) {\n            SafeTransferLib.safeTransferFrom(\n                underlyingToken(),\n                address(panopticPool()),\n                receiver,\n                assets\n            );\n        } else {\n            unchecked {\n                _settleCurrencyDelta(receiver, -int256(assets));\n            }\n        }\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n    }", label="299_ function withdraw(\n        uint256 assets,\n        address receiver,\n        address owner\n    ) external returns (uint256 shares) {\n        _accrueInterest(owner, IS_NOT_DEPOSIT);\n        if (assets > maxWithdraw(owner)) revert Errors.ExceedsMaximumRedemption();\n        if (assets == 0) revert Errors.BelowMinimumRedemption();\n        shares = previewWithdraw(assets);\n        if (msg.sender != owner) {\n            uint256 allowed = allowance[owner][msg.sender];\n            if (allowed != type(uint256).max) allowance[owner][msg.sender] = allowed - shares;  \n        }\n        _burn(owner, shares);\n        s_depositedAssets -= uint128(assets);\n        address _poolManager = address(poolManager());\n        if (_poolManager == address(0)) {\n            SafeTransferLib.safeTransferFrom(\n                underlyingToken(),\n                address(panopticPool()),\n                receiver,\n                assets\n            );\n        } else {\n            unchecked {\n                _settleCurrencyDelta(receiver, -int256(assets));\n            }\n        }\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n    }\n1713-function_definition-300-329", method="withdraw(uint256 assets,address receiver,address owner)", node_type=function_definition, type_label=function_definition];
