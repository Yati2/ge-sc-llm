1068 [code="function updateOI(bytes32 asset, OIDelta memory oiDelta) internal {\n        MarketMetadata storage metadata = StorageLib.loadMarketMetadata(asset);\n        if (oiDelta.long > 0) metadata.longOI += oiDelta.long.abs();\n        else if (oiDelta.long < 0) metadata.longOI -= oiDelta.long.abs();\n        if (oiDelta.short > 0) metadata.shortOI += oiDelta.short.abs();\n        else if (oiDelta.short < 0) metadata.shortOI -= oiDelta.short.abs();\n    }", label="202_ function updateOI(bytes32 asset, OIDelta memory oiDelta) internal {\n        MarketMetadata storage metadata = StorageLib.loadMarketMetadata(asset);\n        if (oiDelta.long > 0) metadata.longOI += oiDelta.long.abs();\n        else if (oiDelta.long < 0) metadata.longOI -= oiDelta.long.abs();\n        if (oiDelta.short > 0) metadata.shortOI += oiDelta.short.abs();\n        else if (oiDelta.short < 0) metadata.shortOI -= oiDelta.short.abs();\n    }\n1068-function_definition-203-209", method="updateOI(bytes32 asset,OIDelta memory oiDelta)", node_type=function_definition, type_label=function_definition];
