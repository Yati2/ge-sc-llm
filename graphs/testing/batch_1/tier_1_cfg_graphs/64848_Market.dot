348 [code="function init(\n        Market storage self,\n        bytes32 asset,\n        MarketSettings memory marketSettings,\n        FundingRateSettings memory fundingSettings,\n        uint256 initialPrice\n    ) internal {\n        self.asset = asset;\n        self.markPrice = initialPrice;\n        StorageLib.loadMarketSettings(asset).init(marketSettings);\n        StorageLib.loadFundingRateSettings(asset).init(fundingSettings);\n        StorageLib.loadFundingRateEngine(asset).lastFundingTime = block.timestamp;\n    }", label="82_ function init(\n        Market storage self,\n        bytes32 asset,\n        MarketSettings memory marketSettings,\n        FundingRateSettings memory fundingSettings,\n        uint256 initialPrice\n    ) internal {\n        self.asset = asset;\n        self.markPrice = initialPrice;\n        StorageLib.loadMarketSettings(asset).init(marketSettings);\n        StorageLib.loadFundingRateSettings(asset).init(fundingSettings);\n        StorageLib.loadFundingRateEngine(asset).lastFundingTime = block.timestamp;\n    }\n348-function_definition-83-95", method="init(Market storage self,bytes32 asset,MarketSettings memory marketSettings,FundingRateSettings memory fundingSettings,uint256 initialPrice)", node_type=function_definition, type_label=function_definition];
