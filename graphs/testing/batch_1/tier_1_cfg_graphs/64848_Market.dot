893 [code="function setMarkPrice(Market storage self, uint256 indexPrice) internal returns (uint256 markPrice) {\n        MarketMetadata storage metadata = StorageLib.loadMarketMetadata(self.asset);\n        _cacheBasisSpread(self, indexPrice);\n        _cacheImpactPrice(self);\n        uint256 p1 = self.getFundingRateComponent(indexPrice);\n        uint256 p2 = (indexPrice.toInt256() + self.getBasisSpreadEMA()).toUint256();\n        uint256 p3 = self.getImpactPriceTwap();\n        self.markPrice = markPrice = _getMedian(p1, p2, p3);\n        metadata.markPriceHistory.snapshot(markPrice);\n        metadata.indexPriceHistory.snapshot(indexPrice);\n        emit MarkPriceUpdated({\n            asset: self.asset,\n            markPrice: markPrice,\n            p1: p1,\n            p2: p2,\n            p3: p3,\n            nonce: StorageLib.incNonce()\n        });\n    }", label="176_ function setMarkPrice(Market storage self, uint256 indexPrice) internal returns (uint256 markPrice) {\n        MarketMetadata storage metadata = StorageLib.loadMarketMetadata(self.asset);\n        _cacheBasisSpread(self, indexPrice);\n        _cacheImpactPrice(self);\n        uint256 p1 = self.getFundingRateComponent(indexPrice);\n        uint256 p2 = (indexPrice.toInt256() + self.getBasisSpreadEMA()).toUint256();\n        uint256 p3 = self.getImpactPriceTwap();\n        self.markPrice = markPrice = _getMedian(p1, p2, p3);\n        metadata.markPriceHistory.snapshot(markPrice);\n        metadata.indexPriceHistory.snapshot(indexPrice);\n        emit MarkPriceUpdated({\n            asset: self.asset,\n            markPrice: markPrice,\n            p1: p1,\n            p2: p2,\n            p3: p3,\n            nonce: StorageLib.incNonce()\n        });\n    }\n893-function_definition-177-195", method="setMarkPrice(Market storage self,uint256 indexPrice)", node_type=function_definition, type_label=function_definition];
