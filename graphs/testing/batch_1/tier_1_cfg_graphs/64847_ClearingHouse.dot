1363 [code="function rebalanceClose(\n        ClearingHouse storage self,\n        DynamicArrayLib.DynamicArray memory assets,\n        Position[] memory positions,\n        int256 margin,\n        int256 marginDelta\n    ) internal view returns (int256 finalMargin, int256 finalMarginDelta) {\n        (uint256 intendedMargin, int256 upnl) = _getIntendedMarginAndUpnl(self, assets, positions);\n        if (intendedMargin == 0) {\n            if (margin < 0) return (margin, 0);\n            else return (0, -margin);\n        }\n        int256 equity = margin + upnl;\n        finalMarginDelta = marginDelta.max((intendedMargin.toInt256() - equity).min(0));\n        finalMargin = margin + finalMarginDelta;\n    }", label="236_ function rebalanceClose(\n        ClearingHouse storage self,\n        DynamicArrayLib.DynamicArray memory assets,\n        Position[] memory positions,\n        int256 margin,\n        int256 marginDelta\n    ) internal view returns (int256 finalMargin, int256 finalMarginDelta) {\n        (uint256 intendedMargin, int256 upnl) = _getIntendedMarginAndUpnl(self, assets, positions);\n        if (intendedMargin == 0) {\n            if (margin < 0) return (margin, 0);\n            else return (0, -margin);\n        }\n        int256 equity = margin + upnl;\n        finalMarginDelta = marginDelta.max((intendedMargin.toInt256() - equity).min(0));\n        finalMargin = margin + finalMarginDelta;\n    }\n1363-function_definition-237-252", method="rebalanceClose(ClearingHouse storage self,DynamicArrayLib.DynamicArray memory assets,Position[] memory positions,int256 margin,int256 marginDelta)", node_type=function_definition, type_label=function_definition];
