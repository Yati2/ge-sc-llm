3669 [code="function assertPostWithdrawalMarginRequired(\n        ClearingHouse storage self,\n        DynamicArrayLib.DynamicArray memory assets,\n        Position[] memory positions,\n        int256 margin\n    ) internal view {\n        if (margin < 0) revert MarginRequirementUnmet();\n        (uint256 intendedMargin, int256 upnl) = _getIntendedMarginAndUpnl(self, assets, positions);\n        uint256 totalNotional = self.getNotionalAccountValue(assets, positions);\n        intendedMargin = intendedMargin.max(totalNotional / 10);\n        if (margin + upnl < intendedMargin.toInt256()) revert MarginRequirementUnmet();\n    }", label="562_ function assertPostWithdrawalMarginRequired(\n        ClearingHouse storage self,\n        DynamicArrayLib.DynamicArray memory assets,\n        Position[] memory positions,\n        int256 margin\n    ) internal view {\n        if (margin < 0) revert MarginRequirementUnmet();\n        (uint256 intendedMargin, int256 upnl) = _getIntendedMarginAndUpnl(self, assets, positions);\n        uint256 totalNotional = self.getNotionalAccountValue(assets, positions);\n        intendedMargin = intendedMargin.max(totalNotional / 10);\n        if (margin + upnl < intendedMargin.toInt256()) revert MarginRequirementUnmet();\n    }\n3669-function_definition-563-574", method="assertPostWithdrawalMarginRequired(ClearingHouse storage self,DynamicArrayLib.DynamicArray memory assets,Position[] memory positions,int256 margin)", node_type=function_definition, type_label=function_definition];
