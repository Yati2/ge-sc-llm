1272 [code="function rebalanceOpen(\n        ClearingHouse storage self,\n        DynamicArrayLib.DynamicArray memory assets,\n        Position[] memory positions,\n        int256 margin,\n        int256 marginDelta\n    ) internal view returns (int256 finalMargin, int256 finalMarginDelta) {\n        (uint256 intendedMargin, int256 upnl) = _getIntendedMarginAndUpnl(self, assets, positions);\n        int256 equity = margin + upnl;\n        finalMarginDelta = marginDelta.min((intendedMargin.toInt256() - equity).max(0));\n        finalMargin = margin + finalMarginDelta;\n    }", label="224_ function rebalanceOpen(\n        ClearingHouse storage self,\n        DynamicArrayLib.DynamicArray memory assets,\n        Position[] memory positions,\n        int256 margin,\n        int256 marginDelta\n    ) internal view returns (int256 finalMargin, int256 finalMarginDelta) {\n        (uint256 intendedMargin, int256 upnl) = _getIntendedMarginAndUpnl(self, assets, positions);\n        int256 equity = margin + upnl;\n        finalMarginDelta = marginDelta.min((intendedMargin.toInt256() - equity).max(0));\n        finalMargin = margin + finalMarginDelta;\n    }\n1272-function_definition-225-236", method="rebalanceOpen(ClearingHouse storage self,DynamicArrayLib.DynamicArray memory assets,Position[] memory positions,int256 margin,int256 marginDelta)", node_type=function_definition, type_label=function_definition];
