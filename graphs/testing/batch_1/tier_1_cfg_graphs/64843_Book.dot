2477 [code="function _getBaseLimit(Book storage self, Limit storage limit, uint256 price, uint256 quoteAmount)\n        private\n        view\n        returns (uint256 baseAmount, uint256 quoteUsed)\n    {\n        uint256 numOrders = limit.numOrders;\n        OrderId orderId = limit.headOrder;\n        uint256 fillAmount;\n        for (uint256 i; i < numOrders; ++i) {\n            if (quoteAmount == 0) break;\n            if (orderId.unwrap() == 0) break;\n            fillAmount = self.orders[orderId].amount.min(quoteAmount.fullMulDiv(1e18, price));\n            baseAmount += fillAmount;\n            quoteUsed += fillAmount.fullMulDiv(price, 1e18);\n            quoteAmount -= fillAmount.fullMulDiv(price, 1e18);\n            orderId = self.orders[orderId].nextOrderId;\n        }\n    }", label="358_ function _getBaseLimit(Book storage self, Limit storage limit, uint256 price, uint256 quoteAmount)\n        private\n        view\n        returns (uint256 baseAmount, uint256 quoteUsed)\n    {\n        uint256 numOrders = limit.numOrders;\n        OrderId orderId = limit.headOrder;\n        uint256 fillAmount;\n        for (uint256 i; i < numOrders; ++i) {\n            if (quoteAmount == 0) break;\n            if (orderId.unwrap() == 0) break;\n            fillAmount = self.orders[orderId].amount.min(quoteAmount.fullMulDiv(1e18, price));\n            baseAmount += fillAmount;\n            quoteUsed += fillAmount.fullMulDiv(price, 1e18);\n            quoteAmount -= fillAmount.fullMulDiv(price, 1e18);\n            orderId = self.orders[orderId].nextOrderId;\n        }\n    }\n2477-function_definition-359-376", method="_getBaseLimit(Book storage self,Limit storage limit,uint256 price,uint256 quoteAmount)", node_type=function_definition, type_label=function_definition];
