1895 [code="function _updateBookPostOrder(Book storage self, Order memory order) private returns (Limit storage limit) {\n        if (order.side == Side.BUY) {\n            limit = self.bidLimits[order.price];\n            if (limit.numOrders == 0) self.bidTree.insert(order.price);\n            self.metadata.numBids++;\n            self.metadata.quoteOI += order.amount.fullMulDiv(order.price, 1e18);\n        } else {\n            limit = self.askLimits[order.price];\n            if (limit.numOrders == 0) self.askTree.insert(order.price);\n            self.metadata.numAsks++;\n            self.metadata.baseOI += order.amount;\n        }\n    }", label="287_ function _updateBookPostOrder(Book storage self, Order memory order) private returns (Limit storage limit) {\n        if (order.side == Side.BUY) {\n            limit = self.bidLimits[order.price];\n            if (limit.numOrders == 0) self.bidTree.insert(order.price);\n            self.metadata.numBids++;\n            self.metadata.quoteOI += order.amount.fullMulDiv(order.price, 1e18);\n        } else {\n            limit = self.askLimits[order.price];\n            if (limit.numOrders == 0) self.askTree.insert(order.price);\n            self.metadata.numAsks++;\n            self.metadata.baseOI += order.amount;\n        }\n    }\n1895-function_definition-288-300", method="_updateBookPostOrder(Book storage self,Order memory order)", node_type=function_definition, type_label=function_definition];
