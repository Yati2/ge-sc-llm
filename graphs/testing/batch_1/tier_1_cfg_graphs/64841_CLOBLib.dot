846 [code="function _processBuyOrder(Book storage ds, Order memory newOrder, PlaceOrderArgs memory args)\n        internal\n        returns (PlaceOrderResult memory result)\n    {\n        result.orderId = newOrder.id.unwrap();\n        (result.quoteTraded, result.baseTraded) = _executeBuyOrder(ds, newOrder, args.tif, args.baseDenominated);\n        if (uint8(args.tif) <= 1) result.basePosted = newOrder.amount;\n    }", label="135_ function _processBuyOrder(Book storage ds, Order memory newOrder, PlaceOrderArgs memory args)\n        internal\n        returns (PlaceOrderResult memory result)\n    {\n        result.orderId = newOrder.id.unwrap();\n        (result.quoteTraded, result.baseTraded) = _executeBuyOrder(ds, newOrder, args.tif, args.baseDenominated);\n        if (uint8(args.tif) <= 1) result.basePosted = newOrder.amount;\n    }\n846-function_definition-136-143", method="_processBuyOrder(Book storage ds,Order memory newOrder,PlaceOrderArgs memory args)", node_type=function_definition, type_label=function_definition];
