2567 [code="function _processAmend(Book storage ds, Order storage order, AmendLimitOrderArgs calldata args)\n        internal\n        returns (int256 notionalDelta, int256 collateralDelta)\n    {\n        if (\n            args.expiryTime.isExpired()\n                || args.baseAmount < StorageLib.loadBookSettings(ds.config.asset).minLimitOrderAmountInBase\n        ) {\n            revert InvalidAmend();\n        } else if (order.side != args.side || order.price != args.price) {\n            return _executeAmendNewOrder(ds, order, args);\n        } else {\n            return _executeAmendAmount(ds, order, args);\n        }\n    }", label="355_ function _processAmend(Book storage ds, Order storage order, AmendLimitOrderArgs calldata args)\n        internal\n        returns (int256 notionalDelta, int256 collateralDelta)\n    {\n        if (\n            args.expiryTime.isExpired()\n                || args.baseAmount < StorageLib.loadBookSettings(ds.config.asset).minLimitOrderAmountInBase\n        ) {\n            revert InvalidAmend();\n        } else if (order.side != args.side || order.price != args.price) {\n            return _executeAmendNewOrder(ds, order, args);\n        } else {\n            return _executeAmendAmount(ds, order, args);\n        }\n    }\n2567-function_definition-356-370", method="_processAmend(Book storage ds,Order storage order,AmendLimitOrderArgs calldata args)", node_type=function_definition, type_label=function_definition];
