6579 [code="library Create2Lib {\n    function deploy(\n        uint256 value,\n        bytes32 salt,\n        bytes memory code\n    ) internal returns (address addr) {\n        assembly {\n            addr := create2(value, add(code, 0x20), mload(code), salt)\n        }\n        require(addr != address(0), \"CREATE2 failed\");\n    }\n}", label="1442_ library Create2Lib {\n    function deploy(\n        uint256 value,\n        bytes32 salt,\n        bytes memory code\n    ) internal returns (address addr) {\n        assembly {\n            addr := create2(value, add(code, 0x20), mload(code), salt)\n        }\n        require(addr != address(0), \"CREATE2 failed\");\n    }\n}\n6579-library_declaration-1443-1454", method="Create2Lib()", node_type=library_declaration, type_label=library_declaration];
