2810 [code="function getSolvencyTicks(\n        int24 currentTick,\n        OraclePack _oraclePack\n    ) external view returns (int24[] memory, OraclePack) {\n        (int24 spotTick, int24 medianTick, int24 latestTick, OraclePack oraclePack) = _oraclePack\n            .getOracleTicks(currentTick, EMA_PERIODS, MAX_CLAMP_DELTA);\n        int24[] memory atTicks;\n        if (\n            int256(spotTick - medianTick) ** 2 +\n                int256(latestTick - medianTick) ** 2 +\n                int256(currentTick - medianTick) ** 2 >\n            MAX_TICKS_DELTA ** 2\n        ) {\n            atTicks = new int24[](4);\n            atTicks[0] = spotTick;\n            atTicks[1] = medianTick;\n            atTicks[2] = latestTick;\n            atTicks[3] = currentTick;\n        } else {\n            atTicks = new int24[](1);\n            atTicks[0] = spotTick;\n        }\n        return (atTicks, oraclePack);\n    }", label="535_ function getSolvencyTicks(\n        int24 currentTick,\n        OraclePack _oraclePack\n    ) external view returns (int24[] memory, OraclePack) {\n        (int24 spotTick, int24 medianTick, int24 latestTick, OraclePack oraclePack) = _oraclePack\n            .getOracleTicks(currentTick, EMA_PERIODS, MAX_CLAMP_DELTA);\n        int24[] memory atTicks;\n        if (\n            int256(spotTick - medianTick) ** 2 +\n                int256(latestTick - medianTick) ** 2 +\n                int256(currentTick - medianTick) ** 2 >\n            MAX_TICKS_DELTA ** 2\n        ) {\n            atTicks = new int24[](4);\n            atTicks[0] = spotTick;\n            atTicks[1] = medianTick;\n            atTicks[2] = latestTick;\n            atTicks[3] = currentTick;\n        } else {\n            atTicks = new int24[](1);\n            atTicks[0] = spotTick;\n        }\n        return (atTicks, oraclePack);\n    }\n2810-function_definition-536-559", method="getSolvencyTicks(int24 currentTick,OraclePack _oraclePack)", node_type=function_definition, type_l