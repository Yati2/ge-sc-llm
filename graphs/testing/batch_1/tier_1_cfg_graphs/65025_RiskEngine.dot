ionComposite(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        atTick\n                                    )\n                                    : 0;\n                        } else {\n                            return\n                                _width\n                                    ? _computeLoanOptionComposite(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        partnerIndex,\n                                        atTick,\n                                        poolUtilization\n                                    )\n                                    : 0;\n                        }\n                    }\n                } else {\n                    if (_tokenType != tokenTypeP) {\n                        if (_isLong != isLongP) {\n                            return\n                                _isLong == 0\n                                    ? _computeDelayedSwap(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        partnerIndex,\n                                        atTick\n                                    )\n                                    : 0;\n                        }\n                    }\n                }\n            }\n        }\n        return\n            _getRequiredCollateralSingleLegNoPartner(\n                tokenId,\n                index,\n                positionSize,\n                atTick,\n                poolUtilization\n            );\n    }\n4705-function_definition-958-1070", method="_getRequiredCollateralSingleLegPartner(TokenId tokenId,uint256 index,uint128 positionSize,int24 atT