6464 [code="contract BuilderWallet {\n    address public immutable FACTORY;\n    address public builderAdmin;\n    constructor(address factory) {\n        FACTORY = factory;\n    }\n    function init(address _builderAdmin) external {\n        builderAdmin = _builderAdmin;\n    }\n    function sweep(address token, address to) external {\n        if (msg.sender != builderAdmin) revert Errors.NotBuilder();\n        uint256 bal = IERC20(token).balanceOf(address(this));\n        if (bal == 0) return;\n        bool ok = IERC20(token).transfer(to, bal);\n        if (!ok) {\n            revert Errors.TransferFailed(token, address(this), bal, bal);\n        }\n    }\n}", label="1423_ contract BuilderWallet {\n    address public immutable FACTORY;\n    address public builderAdmin;\n    constructor(address factory) {\n        FACTORY = factory;\n    }\n    function init(address _builderAdmin) external {\n        builderAdmin = _builderAdmin;\n    }\n    function sweep(address token, address to) external {\n        if (msg.sender != builderAdmin) revert Errors.NotBuilder();\n        uint256 bal = IERC20(token).balanceOf(address(this));\n        if (bal == 0) return;\n        bool ok = IERC20(token).transfer(to, bal);\n        if (!ok) {\n            revert Errors.TransferFailed(token, address(this), bal, bal);\n        }\n    }\n}\n6464-contract_declaration-1424-1442", method="BuilderWallet()", node_type=contract_declaration, type_label=contract_declaration];
