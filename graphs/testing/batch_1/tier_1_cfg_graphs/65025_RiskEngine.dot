3265 [code="function getMargin(\n        PositionBalance[] calldata positionBalanceArray,\n        int24 atTick,\n        address user,\n        TokenId[] calldata positionIdList,\n        LeftRightUnsigned shortPremia,\n        LeftRightUnsigned longPremia,\n        CollateralTracker ct0,\n        CollateralTracker ct1\n    )\n        external\n        view\n        returns (\n            LeftRightUnsigned tokenData0,\n            LeftRightUnsigned tokenData1,\n            PositionBalance globalUtilizations\n        )\n    {\n        if (positionIdList.length != positionBalanceArray.length) revert Errors.LengthMismatch();\n        return\n            _getMargin(\n                positionBalanceArray,\n                positionIdList,\n                atTick,\n                user,\n                shortPremia,\n                longPremia,\n                ct0,\n                ct1\n            );\n    }", label="613_ function getMargin(\n        PositionBalance[] calldata positionBalanceArray,\n        int24 atTick,\n        address user,\n        TokenId[] calldata positionIdList,\n        LeftRightUnsigned shortPremia,\n        LeftRightUnsigned longPremia,\n        CollateralTracker ct0,\n        CollateralTracker ct1\n    )\n        external\n        view\n        returns (\n            LeftRightUnsigned tokenData0,\n            LeftRightUnsigned tokenData1,\n            PositionBalance globalUtilizations\n        )\n    {\n        if (positionIdList.length != positionBalanceArray.length) revert Errors.LengthMismatch();\n        return\n            _getMargin(\n                positionBalanceArray,\n                positionIdList,\n                atTick,\n                user,\n                shortPremia,\n                longPremia,\n                ct0,\n                ct1\n            );\n    }\n3265-function_definition-614-644", method="getMargin(PositionBalance[] calldata positionBalanceArray,int24 atTick,address user,TokenId[] calldata positionIdList,Le