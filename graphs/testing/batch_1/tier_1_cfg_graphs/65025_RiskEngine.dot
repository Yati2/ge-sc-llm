4705 [code="function _getRequiredCollateralSingleLegPartner(\n        TokenId tokenId,\n        uint256 index,\n        uint128 positionSize,\n        int24 atTick,\n        int16 poolUtilization\n    ) internal view returns (uint256) {\n        uint256 partnerIndex = tokenId.riskPartner(index);\n        {\n            if (\n                tokenId.asset(partnerIndex) == tokenId.asset(index) &&\n                tokenId.optionRatio(partnerIndex) == tokenId.optionRatio(index)\n            ) {\n                bool _width = tokenId.width(index) > 0;\n                bool widthP = tokenId.width(partnerIndex) > 0;\n                uint256 _isLong = tokenId.isLong(index);\n                uint256 isLongP = tokenId.isLong(partnerIndex);\n                uint256 _tokenType = tokenId.tokenType(index);\n                uint256 tokenTypeP = tokenId.tokenType(partnerIndex);\n                if (_width && widthP) {\n                    if (_tokenType != tokenTypeP) {\n                        if (_isLong == 0 && isLongP == 0) {\n                            return\n                                _computeStrangle(\n                                    tokenId,\n                                    index,\n                                    positionSize,\n                                    atTick,\n                                    poolUtilization\n                                );\n                        } else if (\n                            _isLong != isLongP &&\n                            tokenId.strike(index) == tokenId.strike(partnerIndex)\n                        ) {\n                            return\n                                _isLong == 0\n                                    ? _getRequiredCollateralSingleLegNoPartner(\n                                        tokenId,\n                                        index,\n                                        positionSize,\n                                        atTick,\n                                        poolUtilization\n                                    )\n                                    : 0;\n                        }\n                    } else {\n                        if (_isLong != isLongP) {\n                            return\n                                index < partnerIndex\n                                    ? _computeSpread(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        partnerIndex,\n                                        atTick,\n                                        poolUtilization\n                                    )\n                                    : 0;\n                        }\n                    }\n                } else if (_width != widthP) {\n                    if (_tokenType == tokenTypeP) {\n                        if (isLongP == 1) {\n                            return\n                                _width\n                                    ? _computeCreditOptionComposite(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        atTick\n                                    )\n                                    : 0;\n                        } else {\n                            return\n                                _width\n                                    ? _computeLoanOptionComposite(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        partnerIndex,\n                                        atTick,\n                                        poolUtilization\n                                    )\n                                    : 0;\n                        }\n                    }\n                } else {\n                    if (_tokenType != tokenTypeP) {\n                        if (_isLong != isLongP) {\n                            return\n                                _isLong == 0\n                                    ? _computeDelayedSwap(\n                                        tokenId,\n                                        positionSize,\n                                        index,\n                                        partnerIndex,\n                                        atTick\n                                    )\n                                    : 0;\n                        }\n                    }\n                }\n            }\n        }\n        return\n            _getRequiredCollateralSingleLegNoPartner(\n                tokenId,\n                index,\n                positionSize,\n                atTick,\n                poolUtilization\n            );\n    }", label="957_ function _getRequiredCollateralSingleLegPartner(\n        TokenId tokenId,\n        uint256 index,\n        uint128 positionSize,\n        int24 atTick,\n        int16 poolUtilization\n    ) internal view returns (uint256) {\n        uint256 partnerIndex = tokenId.riskPartner(index);\n        {\n            if (\n                tokenId.asset(partnerIndex) == tokenId.asset(index) &&\n                tokenId.optionRatio(partnerIndex) == tokenId.optionRatio(index)\n            ) {\n                bool _width = tokenId.width(index) > 0;\n                bool widthP = tokenId.width(partnerIndex) > 0;\n                uint256 _isLong = tokenId.isLong(index);\n                uint256 isLongP = tokenId.isLong(partnerIndex);\n                uint256 _tokenType = tokenId.tokenType(index);\n                uint256 tokenTypeP = tokenId.tokenType(partnerIndex);\n                if (_width && widthP) {\n                    if (_tokenType != tokenTypeP) {\n                        if (_isLong == 0 && isLongP == 0) {\n                            return\n    