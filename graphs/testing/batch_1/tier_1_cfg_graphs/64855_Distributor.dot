807 [code="function _distributeAssets(address base, uint256 baseAmount, address quote, uint256 quoteAmount) internal {\n        if (baseAmount > 0) {\n            _decreaseTotalPending(base, baseAmount);\n            base.safeTransfer(msg.sender, baseAmount);\n        }\n        if (quoteAmount > 0) {\n            _decreaseTotalPending(quote, quoteAmount);\n            quote.safeTransfer(msg.sender, quoteAmount);\n        }\n    }", label="114_ function _distributeAssets(address base, uint256 baseAmount, address quote, uint256 quoteAmount) internal {\n        if (baseAmount > 0) {\n            _decreaseTotalPending(base, baseAmount);\n            base.safeTransfer(msg.sender, baseAmount);\n        }\n        if (quoteAmount > 0) {\n            _decreaseTotalPending(quote, quoteAmount);\n            quote.safeTransfer(msg.sender, quoteAmount);\n        }\n    }\n807-function_definition-115-124", method="_distributeAssets(address base,uint256 baseAmount,address quote,uint256 quoteAmount)", node_type=function_definition, type_label=function_definition];
