618 [code="function increaseStake(address launchAsset, address account, uint96 shares)\n        external\n        onlyLaunchpad\n        returns (uint256 baseAmount, uint256 quoteAmount)\n    {\n        RewardPoolData storage rs = RewardsTrackerStorage.getRewardPool(launchAsset);\n        (baseAmount, quoteAmount) = rs.stake(account, uint96(shares));\n        _distributeAssets(launchAsset, baseAmount, rs.quoteAsset, quoteAmount);\n    }", label="91_ function increaseStake(address launchAsset, address account, uint96 shares)\n        external\n        onlyLaunchpad\n        returns (uint256 baseAmount, uint256 quoteAmount)\n    {\n        RewardPoolData storage rs = RewardsTrackerStorage.getRewardPool(launchAsset);\n        (baseAmount, quoteAmount) = rs.stake(account, uint96(shares));\n        _distributeAssets(launchAsset, baseAmount, rs.quoteAsset, quoteAmount);\n    }\n618-function_definition-92-100", method="increaseStake(address launchAsset,address account,uint96 shares)", node_type=function_definition, type_label=function_definition];
