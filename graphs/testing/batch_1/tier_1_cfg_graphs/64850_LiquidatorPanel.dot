2490 [code="function _validateDeleveragePair(ClearingHouse storage clearingHouse, __DeleverageValidationParams__ memory params)\n        internal\n        view\n    {\n        if (params.makerPositionIdx.max(params.takerPositionIdx) == type(uint256).max) revert InvalidDeleveragePair();\n        if (!clearingHouse.hasBadDebt(params.makerAssets, params.makerPositions, params.makerMargin)) {\n            revert InvalidDeleveragePair();\n        }\n        if (!clearingHouse.isOpenMarginRequirementMet(params.takerAssets, params.takerPositions, params.takerMargin)) {\n            revert InvalidDeleveragePair();\n        }\n        if (\n            params.makerPositions[params.makerPositionIdx].isLong\n                == params.takerPositions[params.takerPositionIdx].isLong\n        ) revert InvalidDeleveragePair();\n    }", label="448_ function _validateDeleveragePair(ClearingHouse storage clearingHouse, __DeleverageValidationParams__ memory params)\n        internal\n        view\n    {\n        if (params.makerPositionIdx.max(params.takerPositionIdx) == type(uint256).max) revert InvalidDeleveragePair();\n        if (!clearingHouse.hasBadDebt(params.makerAssets, params.makerPositions, params.makerMargin)) {\n            revert InvalidDeleveragePair();\n        }\n        if (!clearingHouse.isOpenMarginRequirementMet(params.takerAssets, params.takerPositions, params.takerMargin)) {\n            revert InvalidDeleveragePair();\n        }\n        if (\n            params.makerPositions[params.makerPositionIdx].isLong\n                == params.takerPositions[params.takerPositionIdx].isLong\n        ) revert InvalidDeleveragePair();\n    }\n2490-function_definition-449-464", method="_validateDeleveragePair(ClearingHouse storage clearingHouse,__DeleverageValidationParams__ memory params)", node_type=function_definition, type_label=function_definition];
