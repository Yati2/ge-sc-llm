329 [code="function _fastRedeem(bytes32 _redeemer, uint256 _shareAmount, SendParam memory _sendParam, address _refundAddress) internal virtual {\n         address redeemer = _redeemer.bytes32ToAddress();\n        if (redeemer == address(0)) revert InvalidZeroAddress();\n        uint256 assets = IStakediTryCrosschain(address(VAULT)).fastRedeemThroughComposer(_shareAmount, redeemer, redeemer);  \n          if (assets == 0) {\n            revert NoAssetsToRedeem();\n        }\n        _sendParam.amountLD = assets;\n        _sendParam.minAmountLD = assets;\n        _send(ASSET_OFT, _sendParam, _refundAddress);\n        emit CrosschainFastRedeemProcessed(redeemer, _sendParam.dstEid, _shareAmount, assets);\n    }", label="50_ function _fastRedeem(bytes32 _redeemer, uint256 _shareAmount, SendParam memory _sendParam, address _refundAddress) internal virtual {\n         address redeemer = _redeemer.bytes32ToAddress();\n        if (redeemer == address(0)) revert InvalidZeroAddress();\n        uint256 assets = IStakediTryCrosschain(address(VAULT)).fastRedeemThroughComposer(_shareAmount, redeemer, redeemer);  \n          if (assets == 0) {\n            revert NoAssetsToRedeem();\n        }\n        _sendParam.amountLD = assets;\n        _sendParam.minAmountLD = assets;\n        _send(ASSET_OFT, _sendParam, _refundAddress);\n        emit CrosschainFastRedeemProcessed(redeemer, _sendParam.dstEid, _shareAmount, assets);\n    }\n329-function_definition-51-62", method="_fastRedeem(bytes32 _redeemer,uint256 _shareAmount,SendParam memory _sendParam,address _refundAddress)", node_type=function_definition, type_label=function_definition];
