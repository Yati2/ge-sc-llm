848 [code="function quoteUnstakeReturn(address to, uint256 amount, uint32 dstEid)\n        external\n        view\n        returns (uint256 nativeFee, uint256 lzTokenFee)\n    {\n        if (to == address(0)) revert InvalidZeroAddress();\n        if (amount == 0) revert InvalidAmount();\n        if (dstEid == 0) revert InvalidDestination();\n        SendParam memory sendParam = SendParam({\n            dstEid: dstEid,\n            to: bytes32(uint256(uint160(to))),\n            amountLD: amount,\n            minAmountLD: amount,\n            extraOptions: OptionsBuilder.newOptions(),  \n            composeMsg: \"\",\n            oftCmd: \"\"\n        });\n        MessagingFee memory fee = IOFT(ASSET_OFT).quoteSend(sendParam, false);\n        return (fee.nativeFee, fee.lzTokenFee);\n    }", label="133_ function quoteUnstakeReturn(address to, uint256 amount, uint32 dstEid)\n        external\n        view\n        returns (uint256 nativeFee, uint256 lzTokenFee)\n    {\n        if (to == address(0)) revert InvalidZeroAddress();\n        if (amount == 0) revert InvalidAmount();\n        if (dstEid == 0) revert InvalidDestination();\n        SendParam memory sendParam = SendParam({\n            dstEid: dstEid,\n            to: bytes32(uint256(uint160(to))),\n            amountLD: amount,\n            minAmountLD: amount,\n            extraOptions: OptionsBuilder.newOptions(),  \n            composeMsg: \"\",\n            oftCmd: \"\"\n        });\n        MessagingFee memory fee = IOFT(ASSET_OFT).quoteSend(sendParam, false);\n        return (fee.nativeFee, fee.lzTokenFee);\n    }\n848-function_definition-134-153", method="quoteUnstakeReturn(address to,uint256 amount,uint32 dstEid)", node_type=function_definition, type_label=function_definition];
