549 [code="function rescueToken(address token, address to, uint256 amount) external onlyOwner nonReentrant {\n        if (to == address(0)) revert InvalidZeroAddress();\n        if (amount == 0) revert InvalidAmount();\n        if (token == address(0)) {\n            (bool success,) = to.call{value: amount}(\"\");\n            if (!success) revert TransferFailed();\n        } else {\n            IERC20(token).safeTransfer(to, amount);\n        }\n        emit TokenRescued(token, to, amount);\n    }", label="83_ function rescueToken(address token, address to, uint256 amount) external onlyOwner nonReentrant {\n        if (to == address(0)) revert InvalidZeroAddress();\n        if (amount == 0) revert InvalidAmount();\n        if (token == address(0)) {\n            (bool success,) = to.call{value: amount}(\"\");\n            if (!success) revert TransferFailed();\n        } else {\n            IERC20(token).safeTransfer(to, amount);\n        }\n        emit TokenRescued(token, to, amount);\n    }\n549-function_definition-84-94", method="rescueToken(address token,address to,uint256 amount)", node_type=function_definition, type_label=function_definition];
