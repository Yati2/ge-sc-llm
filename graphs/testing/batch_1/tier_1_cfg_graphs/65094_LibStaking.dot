1081 [code="function confirmFederatedPower(ValidatorSet storage self, address validator, uint256 power) internal {\n        uint256 existingPower = self.validators[validator].federatedPower;\n        self.validators[validator].federatedPower = power;\n        if (existingPower == power) {\n            return;\n        } else if (existingPower < power) {\n            increaseReshuffle({self: self, maybeActive: validator, newPower: power});\n        } else {\n            reduceReshuffle({self: self, validator: validator, newPower: power});\n        }\n    }", label="169_ function confirmFederatedPower(ValidatorSet storage self, address validator, uint256 power) internal {\n        uint256 existingPower = self.validators[validator].federatedPower;\n        self.validators[validator].federatedPower = power;\n        if (existingPower == power) {\n            return;\n        } else if (existingPower < power) {\n            increaseReshuffle({self: self, maybeActive: validator, newPower: power});\n        } else {\n            reduceReshuffle({self: self, validator: validator, newPower: power});\n        }\n    }\n1081-function_definition-170-180", method="confirmFederatedPower(ValidatorSet storage self,address validator,uint256 power)", node_type=function_definition, type_label=function_definition];
