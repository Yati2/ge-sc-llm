1033 [code="function commitTopDownMsg(Subnet storage subnet, IpcEnvelope memory crossMessage) internal {\n        uint64 topDownNonce = subnet.topDownNonce;\n        crossMessage.localNonce = topDownNonce;\n        if (crossMessage.from.subnetId.equals(subnet.id)) {\n            crossMessage.originalNonce = topDownNonce;\n        }\n        subnet.topDownNonce = topDownNonce + 1;\n        subnet.circSupply += crossMessage.value;\n        emit NewTopDownMessage({subnet: subnet.id.getAddress(), message: crossMessage, id: crossMessage.toTracingId()});\n    }", label="170_ function commitTopDownMsg(Subnet storage subnet, IpcEnvelope memory crossMessage) internal {\n        uint64 topDownNonce = subnet.topDownNonce;\n        crossMessage.localNonce = topDownNonce;\n        if (crossMessage.from.subnetId.equals(subnet.id)) {\n            crossMessage.originalNonce = topDownNonce;\n        }\n        subnet.topDownNonce = topDownNonce + 1;\n        subnet.circSupply += crossMessage.value;\n        emit NewTopDownMessage({subnet: subnet.id.getAddress(), message: crossMessage, id: crossMessage.toTracingId()});\n    }\n1033-function_definition-171-180", method="commitTopDownMsg(Subnet storage subnet,IpcEnvelope memory crossMessage)", node_type=function_definition, type_label=function_definition];
