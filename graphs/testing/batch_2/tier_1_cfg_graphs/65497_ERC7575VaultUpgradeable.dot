3057 [code="function _convertToAssets(uint256 shares, Math.Rounding rounding) internal view returns (uint256 assets) {\n        VaultStorage storage $ = _getVaultStorage();\n        uint256 scaling = $.scalingFactor;\n        uint256 normalizedAssets = ShareTokenUpgradeable($.shareToken).convertSharesToNormalizedAssets(shares, rounding);\n        if (scaling == 1) {\n            return normalizedAssets;\n        } else {\n            return Math.mulDiv(normalizedAssets, 1, scaling, rounding);\n        }\n    }", label="403_ function _convertToAssets(uint256 shares, Math.Rounding rounding) internal view returns (uint256 assets) {\n        VaultStorage storage $ = _getVaultStorage();\n        uint256 scaling = $.scalingFactor;\n        uint256 normalizedAssets = ShareTokenUpgradeable($.shareToken).convertSharesToNormalizedAssets(shares, rounding);\n        if (scaling == 1) {\n            return normalizedAssets;\n        } else {\n            return Math.mulDiv(normalizedAssets, 1, scaling, rounding);\n        }\n    }\n3057-function_definition-404-413", method="_convertToAssets(uint256 shares,Math.Rounding rounding)", node_type=function_definition, type_label=function_definition];
