2170 [code="function requestDeploy(\n        address strategy,\n        uint256 amount\n    ) external onlyOwner nonReentrant whenNotPaused returns (uint256 deploymentId) {\n        if (amount == 0) revert ZeroAmount();\n        if (strategy == address(0)) revert ZeroAddress();\n        if (strategy == address(this)) revert SelfDeployNotAllowed();\n        if (!strategies[strategy].isActive) revert StrategyNotActive(strategy);\n        deploymentId = nextDeploymentId++;\n        pendingDeployments[deploymentId] = PendingDeployment({\n            strategy: strategy,\n            amount: amount,\n            requestedAt: block.timestamp,\n            executed: false,\n            cancelled: false\n        });\n        emit DeploymentRequested(deploymentId, strategy, amount, block.timestamp + DEPLOYMENT_DELAY);\n    }", label="358_ function requestDeploy(\n        address strategy,\n        uint256 amount\n    ) external onlyOwner nonReentrant whenNotPaused returns (uint256 deploymentId) {\n        if (amount == 0) revert ZeroAmount();\n        if (strategy == address(0)) revert ZeroAddress();\n        if (strategy == address(this)) revert SelfDeployNotAllowed();\n        if (!strategies[strategy].isActive) revert StrategyNotActive(strategy);\n        deploymentId = nextDeploymentId++;\n        pendingDeployments[deploymentId] = PendingDeployment({\n            strategy: strategy,\n            amount: amount,\n            requestedAt: block.timestamp,\n            executed: false,\n            cancelled: false\n        });\n        emit DeploymentRequested(deploymentId, strategy, amount, block.timestamp + DEPLOYMENT_DELAY);\n    }\n2170-function_definition-359-376", method="requestDeploy(address strategy,uint256 amount)", node_type=function_definition, type_label=function_definition];
