1797 [code="function removeStrategy(address strategy) external onlyOwner {\n        if (!strategies[strategy].isActive) revert StrategyNotFound(strategy);\n        if (strategies[strategy].currentDebt > 0) revert StrategyHasDebt(strategy, strategies[strategy].currentDebt);\n        strategies[strategy].isActive = false;\n        bool found = false;\n        for (uint256 i = 0; i < strategyList.length; i++) {\n            if (strategyList[i] == strategy) {\n                strategyList[i] = strategyList[strategyList.length - 1];\n                strategyList.pop();\n                found = true;\n                break;\n            }\n        }\n        if (!found) revert StrategyNotInList(strategy);\n        emit StrategyRemoved(strategy);\n    }", label="302_ function removeStrategy(address strategy) external onlyOwner {\n        if (!strategies[strategy].isActive) revert StrategyNotFound(strategy);\n        if (strategies[strategy].currentDebt > 0) revert StrategyHasDebt(strategy, strategies[strategy].currentDebt);\n        strategies[strategy].isActive = false;\n        bool found = false;\n        for (uint256 i = 0; i < strategyList.length; i++) {\n            if (strategyList[i] == strategy) {\n                strategyList[i] = strategyList[strategyList.length - 1];\n                strategyList.pop();\n                found = true;\n                break;\n            }\n        }\n        if (!found) revert StrategyNotInList(strategy);\n        emit StrategyRemoved(strategy);\n    }\n1797-function_definition-303-318", method="removeStrategy(address strategy)", node_type=function_definition, type_label=function_definition];
