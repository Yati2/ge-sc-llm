758 [code="function withdraw(uint256 assets, address receiver, address owner) public override nonReentrant returns (uint256) {\n        if (assets == 0) revert ZeroAssets();\n        uint256 claimable = claimableWithdrawals[owner];\n        if (claimable == 0) revert NothingClaimable();\n        if (assets > claimable) revert ExceedsClaimable(assets, claimable);\n        uint256 shares =\n            (assets == claimable)\n                ? claimableWithdrawalShares[owner]\n                : Math.mulDiv(claimableWithdrawalShares[owner], assets, claimable);\n        _claimWithdrawal(owner, receiver, assets, shares);\n        return shares;\n    }", label="149_ function withdraw(uint256 assets, address receiver, address owner) public override nonReentrant returns (uint256) {\n        if (assets == 0) revert ZeroAssets();\n        uint256 claimable = claimableWithdrawals[owner];\n        if (claimable == 0) revert NothingClaimable();\n        if (assets > claimable) revert ExceedsClaimable(assets, claimable);\n        uint256 shares =\n            (assets == claimable)\n                ? claimableWithdrawalShares[owner]\n                : Math.mulDiv(claimableWithdrawalShares[owner], assets, claimable);\n        _claimWithdrawal(owner, receiver, assets, shares);\n        return shares;\n    }\n758-function_definition-150-161", method="withdraw(uint256 assets,address receiver,address owner)", node_type=function_definition, type_label=function_definition];
