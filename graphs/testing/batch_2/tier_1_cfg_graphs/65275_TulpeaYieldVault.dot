2901 [code="function _claimWithdrawal(address owner, address receiver, uint256 assets, uint256 shares) internal {\n        if (msg.sender != owner && !isOperator(owner, msg.sender)) revert Unauthorized();\n        claimableWithdrawals[owner] -= assets;\n        claimableWithdrawalShares[owner] -= shares;\n        totalClaimableWithdrawals -= assets;\n        totalWithdrawn[owner] += assets;\n        IERC20(asset()).safeTransfer(receiver, assets);\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n        emit RedeemClaimed(owner, assets);\n    }", label="465_ function _claimWithdrawal(address owner, address receiver, uint256 assets, uint256 shares) internal {\n        if (msg.sender != owner && !isOperator(owner, msg.sender)) revert Unauthorized();\n        claimableWithdrawals[owner] -= assets;\n        claimableWithdrawalShares[owner] -= shares;\n        totalClaimableWithdrawals -= assets;\n        totalWithdrawn[owner] += assets;\n        IERC20(asset()).safeTransfer(receiver, assets);\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n        emit RedeemClaimed(owner, assets);\n    }\n2901-function_definition-466-475", method="_claimWithdrawal(address owner,address receiver,uint256 assets,uint256 shares)", node_type=function_definition, type_label=function_definition];
