852 [code="function redeem(uint256 shares, address receiver, address owner) public override nonReentrant returns (uint256) {\n        if (shares == 0) revert ZeroShares();\n        uint256 claimable = claimableWithdrawals[owner];\n        uint256 claimShares = claimableWithdrawalShares[owner];\n        if (claimable == 0) revert NothingClaimable();\n        if (shares > claimShares) revert ExceedsClaimable(shares, claimShares);\n        uint256 assets = (shares == claimShares) ? claimable : Math.mulDiv(claimable, shares, claimShares);\n        if (assets == 0) revert ZeroAssets();\n        _claimWithdrawal(owner, receiver, assets, shares);\n        return assets;\n    }", label="161_ function redeem(uint256 shares, address receiver, address owner) public override nonReentrant returns (uint256) {\n        if (shares == 0) revert ZeroShares();\n        uint256 claimable = claimableWithdrawals[owner];\n        uint256 claimShares = claimableWithdrawalShares[owner];\n        if (claimable == 0) revert NothingClaimable();\n        if (shares > claimShares) revert ExceedsClaimable(shares, claimShares);\n        uint256 assets = (shares == claimShares) ? claimable : Math.mulDiv(claimable, shares, claimShares);\n        if (assets == 0) revert ZeroAssets();\n        _claimWithdrawal(owner, receiver, assets, shares);\n        return assets;\n    }\n852-function_definition-162-172", method="redeem(uint256 shares,address receiver,address owner)", node_type=function_definition, type_label=function_definition];
