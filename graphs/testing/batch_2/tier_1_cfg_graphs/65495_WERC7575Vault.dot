867 [code="function _withdraw(uint256 assets, uint256 shares, address receiver, address owner) internal {\n        if (receiver == address(0)) {\n            revert IERC20Errors.ERC20InvalidReceiver(address(0));\n        }\n        if (owner == address(0)) {\n            revert IERC20Errors.ERC20InvalidSender(address(0));\n        }\n        if (assets == 0) revert ZeroAssets();\n        if (shares == 0) revert ZeroShares();\n        _shareToken.spendSelfAllowance(owner, shares);\n        _shareToken.burn(owner, shares);\n        SafeTokenTransfers.safeTransfer(_asset, receiver, assets);\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n    }", label="129_ function _withdraw(uint256 assets, uint256 shares, address receiver, address owner) internal {\n        if (receiver == address(0)) {\n            revert IERC20Errors.ERC20InvalidReceiver(address(0));\n        }\n        if (owner == address(0)) {\n            revert IERC20Errors.ERC20InvalidSender(address(0));\n        }\n        if (assets == 0) revert ZeroAssets();\n        if (shares == 0) revert ZeroShares();\n        _shareToken.spendSelfAllowance(owner, shares);\n        _shareToken.burn(owner, shares);\n        SafeTokenTransfers.safeTransfer(_asset, receiver, assets);\n        emit Withdraw(msg.sender, receiver, owner, assets, shares);\n    }\n867-function_definition-130-143", method="_withdraw(uint256 assets,uint256 shares,address receiver,address owner)", node_type=function_definition, type_label=function_definition];
