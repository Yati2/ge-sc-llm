1418 [code="function convertNormalizedAssetsToShares(uint256 normalizedAssets, Math.Rounding rounding) external view returns (uint256 shares) {\n        (uint256 circulatingSupply, uint256 totalNormalizedAssets) = this.getCirculatingSupplyAndAssets();\n        circulatingSupply += VIRTUAL_SHARES;\n        totalNormalizedAssets += VIRTUAL_ASSETS;\n        shares = Math.mulDiv(normalizedAssets, circulatingSupply, totalNormalizedAssets, rounding);\n    }", label="220_ function convertNormalizedAssetsToShares(uint256 normalizedAssets, Math.Rounding rounding) external view returns (uint256 shares) {\n        (uint256 circulatingSupply, uint256 totalNormalizedAssets) = this.getCirculatingSupplyAndAssets();\n        circulatingSupply += VIRTUAL_SHARES;\n        totalNormalizedAssets += VIRTUAL_ASSETS;\n        shares = Math.mulDiv(normalizedAssets, circulatingSupply, totalNormalizedAssets, rounding);\n    }\n1418-function_definition-221-226", method="convertNormalizedAssetsToShares(uint256 normalizedAssets,Math.Rounding rounding)", node_type=function_definition, type_label=function_definition];
